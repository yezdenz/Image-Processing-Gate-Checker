# ==============================================================================
# Image Processing Gate Checker - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ==============================================================================

# CCTV RTSP Stream Configuration
# Default target stream on LAN
CCTV_RTSP_URL=rtsp://192.168.1.4:554/stream1

# Optional credentials (leave empty if camera allows unauthenticated RTSP)
CCTV_USERNAME=
CCTV_PASSWORD=

# Transport protocol: 'tcp' (recommended for stability) or 'udp'
CCTV_RTSP_TRANSPORT=tcp

# Ingestion & Processing Settings
CCTV_STREAM_RECONNECT_INTERVAL_SEC=5
CCTV_MAX_RECONNECT_ATTEMPTS=10
PROCESSING_FPS=5
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Gate Detection Parameters
GATE_ROI_X=200
GATE_ROI_Y=150
GATE_ROI_WIDTH=880
GATE_ROI_HEIGHT=450
GATE_STATE_CHANGE_THRESHOLD=0.35

# Logging & Auditing
LOG_LEVEL=INFO
AUDIT_LOG_FILE=logs/audit_events.jsonl
AUDIT_SNAPSHOT_DIR=snapshots/audit/

# External Tools
VLC_PATH="C:\Program Files\VideoLAN\VLC\vlc.exe"
